<?xml version="1.0" ?>
<robot name="ev3_manipulator_live_sync" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_color" value="Gazebo/Silver" />

    <!-- ══════════════════════════════════════════════════════════════
        ARM CHAIN
    ══════════════════════════════════════════════════════════════ -->

    <gazebo reference="base_link">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    <gravity>true</gravity>
    </gazebo>

    <gazebo reference="arm_1_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="arm_2_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="arm_2_arm_3_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="arm_4_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="sensor_housing_arm_2_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="arm2_end_support_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <!-- ══════════════════════════════════════════════════════════════
        GRIPPER — gears + fingers
        Finger contact links carry a low-slip friction surface.
        self_collide=false on moving gripper links to avoid the fingers
        fighting each other in contact (a common Gazebo gripper jam).
    ══════════════════════════════════════════════════════════════ -->

    <gazebo reference="left_gear_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="right_gear_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="left_inner_finger_1">
    <material>${body_color}</material>
    <self_collide>false</self_collide>
    <collision name="left_inner_finger_1_collision">
        <surface>
        <friction>
            <ode>
            <mu>0.1</mu>
            <mu2>0.1</mu2>
            <slip1>0.05</slip1>
            <slip2>0.05</slip2>
            </ode>
        </friction>
        </surface>
    </collision>
    </gazebo>

    <gazebo reference="left_outer_finger_1">
    <material>${body_color}</material>
    <self_collide>false</self_collide>
    <collision name="left_outer_finger_1_collision">
        <surface>
        <friction>
            <ode>
            <mu>0.1</mu>
            <mu2>0.1</mu2>
            <slip1>0.05</slip1>
            <slip2>0.05</slip2>
            </ode>
        </friction>
        </surface>
    </collision>
    </gazebo>

    <gazebo reference="right_inner_finger_1">
    <material>${body_color}</material>
    <self_collide>false</self_collide>
    <collision name="right_inner_finger_1_collision">
        <surface>
        <friction>
            <ode>
            <mu>0.1</mu>
            <mu2>0.1</mu2>
            <slip1>0.05</slip1>
            <slip2>0.05</slip2>
            </ode>
        </friction>
        </surface>
    </collision>
    </gazebo>

    <gazebo reference="right_outer_finger_1">
    <material>${body_color}</material>
    <self_collide>false</self_collide>
    <collision name="right_outer_finger_1_collision">
        <surface>
        <friction>
            <ode>
            <mu>0.1</mu>
            <mu2>0.1</mu2>
            <slip1>0.05</slip1>
            <slip2>0.05</slip2>
            </ode>
        </friction>
        </surface>
    </collision>
    </gazebo>

    <gazebo reference="motor_shaft_arm_4_outer_gripper_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="motor_shaft_arm_4_inner_gripper_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <!-- ══════════════════════════════════════════════════════════════
        CONVEYOR + STATIC STRUCTURE
    ══════════════════════════════════════════════════════════════ -->

    <gazebo reference="conveyor_belt_link_1">
    <material>${body_color}</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="left_pulley_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="right_pulley_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="bench_support_left_pulley_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="bench_support_right_pulley_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="bench_support_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="base_link_bench_support_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="base_motor_housing_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="bench_stand_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="sensor_housing_link_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    </gazebo>

    <!-- ══════════════════════════════════════════════════════════════
        gz_ros2_control plugin — kept exactly as the working setup
        (Humble + Ignition Fortress). Only the controller.yaml path and
        the global fallback gain live here.
    ══════════════════════════════════════════════════════════════ -->
    <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ev3_manipulator_live_sync)/config/controller.yaml</parameters>
        <position_proportional_gain>120.0</position_proportional_gain>
    </plugin>
    </gazebo>

</robot>