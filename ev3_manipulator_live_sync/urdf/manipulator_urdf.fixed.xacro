<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ev3_manipulator_live_sync">

    <!-- ══════════════════════════════════════════════════════════════════════
        WORLD ANCHOR — fixes base_link so the arm does not drift/fall.
    ══════════════════════════════════════════════════════════════════════ -->
    <link name="world"/>
    <joint name="world_to_base_fixed" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ══════════════════════════════════════════════════════════════════════
        LINKS (unchanged from source design)
    ══════════════════════════════════════════════════════════════════════ -->

