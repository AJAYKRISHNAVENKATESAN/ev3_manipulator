    <link name="conveyor_belt_link_1">
      <inertial>
        <origin xyz="0.09885577098748011 0.08312907654316704 0.012944406589581724" rpy="0 0 0"/>
        <mass value="0.31573416000792753"/>
        <inertia ixx="0.00018" iyy="0.004287" izz="0.004245" ixy="-5e-06" iyz="-1e-06" ixz="-2e-06"/>
