      <parent link="bench_support_right_pulley_link_1"/>
      <child link="right_pulley_link_1"/>
      <axis xyz="0.0 -1.0 0.0"/>
      <dynamics damping="0.1" friction="0.01"/>
      <mimic joint="conveyor_left_pulley_joint" multiplier="-1" offset="0"/>
    </joint>

    <!-- ══════════════════════════════════════════════════════════════════════
