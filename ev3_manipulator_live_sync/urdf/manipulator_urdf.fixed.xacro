    <!-- ══════════════════════════════════════════════════════════════════════
        ARM JOINTS (driven + parallelogram mimic)
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- Motor A: base rotation (driven) -->
    <joint name="arm1_base_link_joint" type="revolute">
      <origin xyz="-0.02 0.104 0.04" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="arm_1_1"/>
      <axis xyz="0.0 0.0 -1.0"/>
      <limit lower="-3.14159" upper="3.14159" effort="80" velocity="3"/>
      <dynamics damping="2.0" friction="0.5"/>
    </joint>

    <!-- Motor B: arm pitch (driven) — pitches up/down -->
    <joint name="arm1_arm2_joint" type="revolute">
      <origin xyz="-0.020125 -0.0675 0.115" rpy="0 0 0"/>
      <parent link="arm_1_1"/>
      <child link="arm_2_1"/>
      <axis xyz="-1.0 0.0 0.0"/>
      <limit lower="-1.5708" upper="1.5708" effort="50" velocity="3"/>
      <dynamics damping="1.5" friction="0.05"/>
    </joint>

    <!-- Parallelogram wrist: mimics pitch in the OPPOSITE direction (-1) -->
    <joint name="arm_2_3_connector_arm_2_joint" type="revolute">
      <origin xyz="0.01 0.184946 0.007014" rpy="0 0 0"/>
      <parent link="arm_2_1"/>
      <child link="arm_2_arm_3_link_1"/>
      <axis xyz="-1.0 0.0 0.0"/>
      <limit lower="-1.5708" upper="1.5708" effort="50" velocity="1.5"/>
      <dynamics damping="1.0" friction="0.2"/>
      <mimic joint="arm1_arm2_joint" multiplier="-1" offset="0"/>
    </joint>

    <!-- ══════════════════════════════════════════════════════════════════════
        GRIPPER JOINTS — master + followers (all mimic left_gear_arm4_joint, -1)
        Finger limits: wide (extreme- to extreme+).
        If the RIGHT fingers open when they should close, flip the three
        right-side mimic joints to multiplier +1 and rebuild.
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- Motor C: gripper master (driven) -->
    <joint name="left_gear_arm4_joint" type="revolute">
      <origin xyz="0.005135 0.017232 -0.069606" rpy="0 0 0"/>
      <parent link="arm_4_1"/>
      <child link="left_gear_1"/>
      <axis xyz="0.0 -1.0 0.0"/>
      <limit lower="-0.8" upper="0.8" effort="15" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.005"/>
    </joint>

    <!-- Right gear: FLIP to +1 if right side opens instead of closes -->
    <joint name="right_gear_arm4_joint" type="revolute">
      <origin xyz="0.005135 0.003232 -0.069606" rpy="0 0 0"/>
      <parent link="arm_4_1"/>
      <child link="right_gear_1"/>
      <axis xyz="0.0 -1.0 0.0"/>
      <limit lower="-1.5708" upper="1.5708" effort="15" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.005"/>
      <mimic joint="left_gear_arm4_joint" multiplier="-1" offset="0"/>
    </joint>

    <joint name="left_inner_finger_arm4_joint" type="revolute">
      <origin xyz="-0.002375 0.012066 -0.018016" rpy="0 0 0"/>
      <parent link="motor_shaft_arm_4_inner_gripper_1"/>
      <child link="left_inner_finger_1"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.001"/>
      <mimic joint="left_gear_arm4_joint" multiplier="-1" offset="0"/>
    </joint>

    <joint name="left_outer_finger_arm4_joint" type="revolute">
      <origin xyz="0.002625 0.012066 -0.018016" rpy="0 0 0"/>
      <parent link="motor_shaft_arm_4_outer_gripper_1"/>
      <child link="left_outer_finger_1"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.001"/>
      <mimic joint="left_gear_arm4_joint" multiplier="-1" offset="0"/>
    </joint>

    <!-- Right inner finger: FLIP to +1 with the right side if needed -->
    <joint name="right_inner_finger_arm4_joint" type="revolute">
      <origin xyz="-0.002375 -0.012934 -0.018016" rpy="0 0 0"/>
      <parent link="motor_shaft_arm_4_inner_gripper_1"/>
      <child link="right_inner_finger_1"/>
      <axis xyz="0.0 -1.0 0.0"/>
      <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.001"/>
      <mimic joint="left_gear_arm4_joint" multiplier="-1" offset="0"/>
    </joint>

    <!-- Right outer finger: FLIP to +1 with the right side if needed -->
    <joint name="right_outer_finger_arm4_joint" type="revolute">
      <origin xyz="0.002625 -0.012934 -0.018016" rpy="0 0 0"/>
      <parent link="motor_shaft_arm_4_outer_gripper_1"/>
      <child link="right_outer_finger_1"/>
      <axis xyz="0.0 -1.0 0.0"/>
      <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.001"/>
      <mimic joint="left_gear_arm4_joint" multiplier="-1" offset="0"/>
    </joint>

    <!-- ══════════════════════════════════════════════════════════════════════
        GRIPPER FIXED MOUNTS
    ══════════════════════════════════════════════════════════════════════ -->

    <joint name="motor_shaft_outer_gripper_arm_4_joint" type="fixed">
      <origin xyz="0.015243 0.010732 -0.047618" rpy="0 0 0"/>
      <parent link="arm_4_1"/>
      <child link="motor_shaft_arm_4_outer_gripper_1"/>
    </joint>

    <joint name="motor_shaft_inner_gripper_arm_4_joint" type="fixed">
      <origin xyz="-0.004757 0.010732 -0.047618" rpy="0 0 0"/>
      <parent link="arm_4_1"/>
      <child link="motor_shaft_arm_4_inner_gripper_1"/>
    </joint>

    <joint name="arm_2_3_connector_arm_4_joint" type="fixed">
      <origin xyz="0.002518 0.002515 -0.009128" rpy="0 0 0"/>
      <parent link="arm_2_arm_3_link_1"/>
      <child link="arm_4_1"/>
    </joint>

    <joint name="arm_sensor_joint" type="fixed">
      <origin xyz="0.015 0.035303 0.008514" rpy="0 0 0"/>
      <parent link="arm_2_1"/>
      <child link="sensor_housing_arm_2_1"/>
    </joint>

    <joint name="arm2_support_arm_joint" type="fixed">
      <origin xyz="-0.005 -5.4e-05 0.008514" rpy="0 0 0"/>
      <parent link="arm_2_1"/>
      <child link="arm2_end_support_1"/>
    </joint>

    <!-- ══════════════════════════════════════════════════════════════════════
        CONVEYOR JOINTS
        'Revolute 1' renamed -> 'conveyor_left_pulley_joint'. Cosmetic.
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- Motor D: conveyor drive (driven, velocity) -->
    <joint name="conveyor_left_pulley_joint" type="continuous">
      <origin xyz="0.000606 0.0065 -0.001896" rpy="0 0 0"/>
      <parent link="bench_support_left_pulley_link_1"/>
      <child link="left_pulley_link_1"/>
      <axis xyz="0.0 1.0 0.0"/>
